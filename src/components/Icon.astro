---
import { brandIcons } from "../lib/brand-icons.mjs";
import { socialIcons } from "../lib/social-icons.mjs";
import { sitePath } from "../lib/paths";

interface Props {
  name: string;
  size?: number;
  /** Force currentColor, ignoring the brand color. */
  mono?: boolean;
}
const { name, size = 14, mono = false } = Astro.props;

/** A path inside a stroked mark that is tinted instead of outlined. */
type VectorPart = string | { d: string; fill?: boolean; opacity?: number };

type IconData =
  | {
      viewBox: string;
      d: string | VectorPart[];
      rule?: "evenodd" | "nonzero";
      color?: string;
      /** Optical size multiplier for marks that are not full-bleed squares. */
      scale?: number;
      /** Stroke width in viewBox units; renders the mark as an outline. */
      stroke?: number;
    }
  | { src: string; mask?: boolean; scale?: number };

const icons = { ...socialIcons, ...brandIcons } as Record<string, IconData>;
const item = icons[name];
const viewBox = item && "viewBox" in item ? item.viewBox : undefined;
const [, , w, h] = (viewBox ?? "0 0 1 1").split(" ").map(Number);
const px = Math.max(
  1,
  Math.round(size * (item && "scale" in item ? (item.scale ?? 1) : 1)),
);
const width = Math.round((px * w) / h);
const parts =
  item && !("src" in item)
    ? (Array.isArray(item.d) ? item.d : [item.d]).map((part) =>
        typeof part === "string" ? { d: part } : part,
      )
    : [];
---

{item &&
  ("src" in item ? (
    item.mask || mono ? (
      <span
        class="brand-mask"
        style={`--mask-icon:url(${sitePath(item.src)});--mask-size:${px}px`}
        aria-hidden="true"
      />
    ) : (
      <img
        class="brand-image"
        src={sitePath(item.src)}
        width={px}
        height={px}
        alt=""
        decoding="async"
      />
    )
  ) : (
    <svg
      aria-hidden="true"
      viewBox={item.viewBox}
      width={width}
      height={px}
      fill={
        item.stroke
          ? "none"
          : mono
            ? "currentColor"
            : (item.color ?? "currentColor")
      }
      fill-rule={item.rule}
      stroke={item.stroke ? (item.color ?? "currentColor") : undefined}
      stroke-width={item.stroke}
      stroke-linecap={item.stroke ? "round" : undefined}
      stroke-linejoin={item.stroke ? "round" : undefined}
    >
      {parts.map((part) => (
        <path
          d={part.d}
          opacity={part.opacity}
          fill={part.fill ? "currentColor" : undefined}
          stroke={part.fill ? "none" : undefined}
        />
      ))}
    </svg>
  ))}
