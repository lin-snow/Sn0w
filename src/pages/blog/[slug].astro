---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Lightbox from "../../components/Lightbox.astro";
import { site } from "../../config";
import { excerpt } from "../../lib/excerpt.mjs";
import { absoluteUrl, currentUrl } from "../../lib/urls";
import { selectPublished } from "../../lib/publication.mjs";

export async function getStaticPaths() {
  return selectPublished(await getCollection("posts")).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const description = post.data.description ?? excerpt(post.body);
const pageUrl = currentUrl(Astro.site, Astro.url.pathname);
const homeUrl = absoluteUrl(Astro.site, "/");
const blogUrl = absoluteUrl(Astro.site, "blog/");
const avatarUrl = absoluteUrl(Astro.site, "avatar.png");
const ogUrl = absoluteUrl(Astro.site, "og.png");
const modified = post.data.updated ?? post.data.date;
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  image: {
    "@type": "ImageObject",
    url: ogUrl,
    width: 1200,
    height: 630,
  },
  datePublished: post.data.date,
  dateModified: modified,
  inLanguage: "zh-CN",
  author: {
    "@type": "Person",
    "@id": `${homeUrl}#person`,
    name: site.author,
    url: homeUrl,
    sameAs: site.social.map((item) => item.href),
  },
  publisher: {
    "@type": "Organization",
    "@id": `${homeUrl}#publisher`,
    name: site.name,
    url: homeUrl,
    logo: {
      "@type": "ImageObject",
      url: avatarUrl,
      width: 480,
      height: 480,
    },
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${homeUrl}#website`,
    name: site.name,
    url: homeUrl,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  url: pageUrl,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: homeUrl },
    { "@type": "ListItem", position: 2, name: "博客", item: blogUrl },
    { "@type": "ListItem", position: 3, name: post.data.title, item: pageUrl },
  ],
};
---

<Base
  title={post.data.title}
  description={description}
  article={post.data.title}
  published={post.data.date}
  modified={modified}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date}>{post.data.date}</time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Lightbox />
</Base>
