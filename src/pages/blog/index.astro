---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../config";
import { selectPublished } from "../../lib/publication.mjs";
import { sitePath } from "../../lib/paths";
import { absoluteUrl, currentUrl } from "../../lib/urls";

const description = `${site.name} 的全部文章，按年份排列。`;
const posts = selectPublished(await getCollection("posts"));
const years = [...new Set(posts.map((post) => post.data.date.slice(0, 4)))];
const blogUrl = currentUrl(Astro.site, Astro.url.pathname);
const absolute = (path: string) => absoluteUrl(Astro.site, path);
const blogLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${blogUrl}#blog`,
  name: `${site.name} Blog`,
  url: blogUrl,
  description,
  inLanguage: "zh-CN",
  author: {
    "@type": "Person",
    "@id": `${absolute("/")}#person`,
    name: site.author,
    url: absolute("/"),
    sameAs: site.social.map((item) => item.href),
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${absolute("/")}#website`,
    name: site.name,
    url: absolute("/"),
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description ?? undefined,
    url: absolute(`blog/${post.id}/`),
    datePublished: post.data.date,
    dateModified: post.data.updated ?? post.data.date,
  })),
};
---

<Base title="Blog" description={description} current="Blog" jsonLd={blogLd}>
  <h1 class="page-title">Articles</h1>
  {posts.length === 0 && <p class="empty-note">还没有公开文章。</p>}
  {years.map((year) => (
    <section class="post-year" data-year={year} aria-label={`${year} 年文章`}>
      <h2>{year}</h2>
      <ul class="post-list">
        {posts
          .filter((post) => post.data.date.startsWith(year))
          .map((post) => (
            <li>
              <a href={sitePath(`blog/${post.id}/`)}>{post.data.title}</a>
              <time datetime={post.data.date}>
                {post.data.date.slice(5).replace("-", "/")}
              </time>
            </li>
          ))}
      </ul>
    </section>
  ))}
</Base>
