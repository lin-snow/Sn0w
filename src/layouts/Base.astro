---
import { site } from "../config";
import { sitePath } from "../lib/paths";
import Breadcrumb from "../components/Breadcrumb.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: string;
  article?: string;
  image?: string;
  published?: string;
  modified?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  current,
  article,
  image,
  published,
  modified,
  noindex,
  jsonLd,
} = Astro.props;
const documentTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical =
  Astro.site && !noindex
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const absolute = (path: string) =>
  Astro.site ? new URL(sitePath(path), Astro.site).href : sitePath(path);
const ogImage = image
  ? /^https?:\/\//.test(image)
    ? image
    : absolute(image)
  : Astro.site
    ? absolute("avatar.png")
    : undefined;
const ogImageAlt = image ? documentTitle : `${site.name} 的头像`;
const articleDate = (value: string) =>
  value.includes("T") ? value : `${value}T00:00:00.000Z`;
const breadcrumb =
  current && !article && !noindex
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "首页",
            item: absolute("/"),
          },
          {
            "@type": "ListItem",
            position: 2,
            name: current,
            item: canonical ?? Astro.url.pathname,
          },
        ],
      }
    : undefined;
const structuredData = [
  ...(breadcrumb ? [breadcrumb] : []),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
const serializeJsonLd = (value: Record<string, unknown>) =>
  JSON.stringify(value).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.dataset.js = "true";
      try {
        var saved = localStorage.getItem("theme");
        document.documentElement.dataset.theme =
          saved === "light" || saved === "dark"
            ? saved
            : matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href={sitePath("rss.xml")}
    />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{documentTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href={sitePath("favicon.ico")} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={sitePath("favicon-32x32.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={sitePath("favicon-16x16.png")}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={sitePath("apple-touch-icon.png")}
    />
    <meta
      name="theme-color"
      content="#111110"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImage && !image && (
      <>
        <meta property="og:image:width" content="480" />
        <meta property="og:image:height" content="480" />
      </>
    )}
    {article && published && (
      <meta
        property="article:published_time"
        content={articleDate(published)}
      />
    )}
    {article && (modified ?? published) && (
      <meta
        property="article:modified_time"
        content={articleDate((modified ?? published)!)}
      />
    )}
    {article && <meta property="article:author" content={site.author} />}
    <meta name="twitter:card" content="summary" />
    {site.twitter && <meta name="twitter:site" content={site.twitter} />}
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <div class="shell">
      <button type="button" class="theme-toggle" aria-label="切换配色">
        <svg
          class="icon-sun"
          aria-hidden="true"
          viewBox="0 0 16 16"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <circle cx="8" cy="8" r="2.2"></circle>
          <path d="M8 1.6v1.6M8 12.8v1.6M1.6 8h1.6M12.8 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1"></path>
        </svg>
        <svg
          class="icon-moon"
          aria-hidden="true"
          viewBox="0 0 16 16"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9.2 2.2a4.8 4.8 0 1 0 4.6 6.4 3.8 3.8 0 1 1-4.6-6.4z"></path>
        </svg>
      </button>
      <Breadcrumb current={current} article={article} />
      <main id="main">
        <slot />
      </main>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const syncThemeButton = () => {
        const light = document.documentElement.dataset.theme === "light";
        toggle?.setAttribute("aria-label", light ? "切换为深色" : "切换为浅色");
      };
      syncThemeButton();
      toggle?.addEventListener("click", () => {
        const next =
          document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        syncThemeButton();
      });
    </script>
  </body>
</html>
